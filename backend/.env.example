# Copie este archivo como ".env" y complete los valores.
# El archivo .env real nunca se sube al repositorio.

# Puerto del servidor
PORT=4000

# Cadena de conexion a MongoDB (local o MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/crm_zenith

# Clave para firmar los tokens JWT (use una cadena larga y dificil de adivinar)
JWT_SECRET=cambie_esta_clave_por_una_propia
JWT_EXPIRES_IN=8h

# Origen permitido para el frontend (CORS). Use * solo en desarrollo.
CLIENT_ORIGIN=*
